root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 180

[*.cs]

# Layout
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
csharp_preferred_modifier_order = public, private, protected, internal, file, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, required, volatile, async:suggestion
resharper_csharp_wrap_parameters_style = chop_if_long

# Type Syntax
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
dotnet_style_prefer_collection_expression = true:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Expression Body
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

# Braces
csharp_prefer_braces = false:suggestion

resharper_csharp_braces_for_ifelse = required_for_multiline
resharper_csharp_braces_for_for = not_required
resharper_csharp_braces_for_foreach = not_required
resharper_csharp_braces_for_while = not_required
resharper_csharp_braces_for_dowhile = not_required
resharper_csharp_braces_for_using = not_required
resharper_csharp_braces_for_lock = not_required

# Qualification
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Initializers
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

# Null Handling
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# Pattern Matching
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_extended_property_pattern = true:suggestion

# Parentheses
resharper_csharp_parentheses_redundancy_style = remove
resharper_csharp_parentheses_non_obvious_operations = none
resharper_csharp_parentheses_group_non_obvious_operations = none
resharper_csharp_parentheses_same_type_operations = false

# Switches
csharp_style_prefer_switch_expression = true:suggestion

# Fields
dotnet_style_readonly_field = true:suggestion

# Usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Constants
dotnet_naming_rule.constants_should_be_all_caps.symbols = constants
dotnet_naming_rule.constants_should_be_all_caps.style = all_caps
dotnet_naming_rule.constants_should_be_all_caps.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.constants.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_style.all_caps.capitalization = all_upper
dotnet_naming_style.all_caps.word_separator = _

# Private Fields
dotnet_naming_rule.private_static_readonly_fields_should_be_pascal_case.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_fields_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.private_static_readonly_fields_should_be_pascal_case.severity = warning

dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private

dotnet_naming_rule.private_fields_should_be_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Private Properties
dotnet_naming_rule.private_properties_should_be_pascal_case.symbols = private_properties
dotnet_naming_rule.private_properties_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.private_properties_should_be_pascal_case.severity = warning

dotnet_naming_symbols.private_properties.applicable_kinds = property
dotnet_naming_symbols.private_properties.applicable_accessibilities = private

# Public Members
dotnet_naming_rule.public_fields_and_properties_should_be_pascal_case.symbols = public_fields_and_properties
dotnet_naming_rule.public_fields_and_properties_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.public_fields_and_properties_should_be_pascal_case.severity = warning

dotnet_naming_symbols.public_fields_and_properties.applicable_kinds = field, property
dotnet_naming_symbols.public_fields_and_properties.applicable_accessibilities = public

# PascalCase
dotnet_naming_style.pascal_case.capitalization = pascal_case
